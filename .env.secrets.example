# Secret values for scripts/deploy-profile.sh — copy to `.env.secrets` and fill in.
# `.env.secrets` is gitignored; this example is safe to commit.
#
# Any value left blank is handled as follows by the deploy script:
#   SECRET_KEY, WEBHOOK_SECRET            -> auto-generated (openssl rand -hex 32)
#   NX_CREDENTIAL_ENCRYPTION_KEY (blank)  -> Nx calls will 502 (decrypt can't run)
#   MAILTRAP_API_TOKEN (blank)            -> email sending is a no-op

# JWT signing key (HS256). Any high-entropy string. Leave blank to auto-generate.
SECRET_KEY=

# Shared secret for POST /api/v1/webhooks/alert (X-Webhook-Secret). Leave blank to auto-generate.
WEBHOOK_SECRET=

# Fernet key that decrypts each site's stored Nx Witness password. MUST be the
# same key the passwords were encrypted with (e.g. when migrating existing data).
# Generate a fresh one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NX_CREDENTIAL_ENCRYPTION_KEY=

# Mailtrap API token for invite emails (optional; blank disables email).
MAILTRAP_API_TOKEN=

TEST_EMAIL_TO=

# IMPORTANT: this file is SOURCED by bash (deploy-profile.sh does `. ./.env.secrets`).
# JSON values MUST be a SINGLE LINE wrapped in SINGLE QUOTES, with no // comments —
# otherwise bash word-splits/brace-expands the value and the deploy aborts with
# errors like `username:: command not found`.
#
# Per-organization Nx Witness credentials, consumed by the footage-history path.
# JSON map of organization_id -> {username,password}. Stored in Secrets Manager
# under `nxCredentials`; the VMS username+password never touch DynamoDB. Leave as
# {} to deploy without creds (footage history 502s until an org is populated).
# Example (single line, single-quoted):
#   NX_CREDENTIALS_JSON='{"<organization_id>":{"username":"admin","password":"..."}}'
NX_CREDENTIALS_JSON={}

# One Nx credential set whitelisted to SEVERAL orgs. Any org_id listed in orgIds
# resolves to these credentials (a per-org entry in NX_CREDENTIALS_JSON overrides
# it). Use this when multiple organizations share the same VMS login.
# Example (single line, single-quoted):
#   NX_SHARED_CREDENTIALS_JSON='{"username":"admin","password":"...","orgIds":["<org_id_1>","<org_id_2>"]}'
NX_SHARED_CREDENTIALS_JSON='{"username":"nx-username","password":"nx-password","orgIds":[""]}'